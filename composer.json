{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "bagart/telegram-game-mafia",
    "description": "Mafia (Werewolf) game module for the Telegram bot platform: dual interface (group + private rooms), AI filler players, 16 roles, i18n",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "telegram",
        "telegram-bot",
        "mafia",
        "werewolf",
        "game",
        "bot-platform",
        "module",
        "tg-module"
    ],
    "authors": [
        {
            "name": "BAGArt (Artur Baltaev)",
            "email": "baltaev.artur+ask@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5"
    },
    "suggest": {
        "bagart/telegram-bot-lib": "Telegram platform runtime contracts (provided by the host app)"
    },
    "repositories": {
        "baseline": {
            "type": "path",
            "url": "../telegram-devops-baseline"
        },
        "0": {
            "type": "path",
            "url": "../telegram-bot-lib"
        },
        "1": {
            "type": "path",
            "url": "../php-async-kernel-lib"
        },
        "2": {
            "type": "path",
            "url": "../php-async-kernel-client"
        },
        "3": {
            "type": "path",
            "url": "stubs/daemon-runner"
        }
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "bagart/telegram-devops-baseline": "@dev"
    },
    "autoload": {
        "psr-4": {
            "BAGArt\\TelegramBotMafia\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BAGArt\\TelegramBotMafia\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "composer exec pest",
        "lint": "pint --dirty"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
